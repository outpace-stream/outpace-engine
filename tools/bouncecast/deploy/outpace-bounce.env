# Settings for outpace-broadcast.service. Installed as /etc/outpace-bounce.env.
# The HTTP API has no authentication: keep it on a trusted LAN.
OUTPACE_BIND=0.0.0.0:6878
OUTPACE_RTMP_BIND=127.0.0.1:1935
# Forward external TCP 8623 on the router to this host's 8623 so peers can reach the broadcast.
OUTPACE_PEER_LISTEN=0.0.0.0:8623
OUTPACE_DATA_DIR=/var/lib/outpace
OUTPACE_CACHE_TYPE=memory
# Profiles apply when the identity is first created; see docs/wiki/Broadcasting.md.
OUTPACE_BROADCAST_OPTIONS='{"outpace-bounce":{"title":"Outpace Bounce 24/7","bitrate_bytes_per_sec":1100000,"piece_length":262144,"quality":"HD","categories":["other"]}}'
