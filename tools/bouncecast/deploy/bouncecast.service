[Unit]
Description=Bouncecast synthetic feed for outpace-bounce
After=outpace-broadcast.service
Wants=outpace-broadcast.service
PartOf=outpace-broadcast.service
StartLimitIntervalSec=0

[Service]
User=outpace
Group=outpace
# Exits when ffmpeg or the RTMP ingest goes away; systemd restarts it, and outpace carries the
# same broadcast identity and piece numbering across the reconnect.
# GPU rendering (Vulkan) and GPU H.264 encoding (VAAPI) on /dev/dri/renderD128. For a host
# without a GPU, drop --renderer/--encoder to use the CPU renderer and libx264.
ExecStart=/usr/local/bin/bouncecast --renderer gpu --encoder vaapi --fps 60 --output rtmp://127.0.0.1:1935/live/outpace-bounce
SupplementaryGroups=render
# Writable home for Mesa's shader cache (the rest of the filesystem is read-only).
CacheDirectory=bouncecast
Environment=XDG_CACHE_HOME=/var/cache/bouncecast
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
